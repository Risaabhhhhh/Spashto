{
  "manifest_version": 3,
  "name": "Spashto: Legal Text Simplifier",
  "version": "1.0",
  "description": "Simplifies Indian government legal text and provides a tax procedural guide.",
  "permissions": [
    "contextMenus",
    "sidePanel",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "dist/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/extractor.js"]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Spashto"
  },
  "icons": {
    "128": "public/icons/icon128.png"
  }
}
